<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xmlns:mie="Mane.Unity.Editor"
         editor-extension-mode="True">

    <Style src="ManeTextEditor.uss" />

    <ui:VisualElement name="emptyFontBox" class="message-box">
        <ui:Image class="message-icon" />
        <ui:Label name="emptyFontLabel" class="message-box-label"
                  text="At first, assign a font." />
    </ui:VisualElement>

    <ui:VisualElement class="mie-block">
        <uie:ObjectField name="fontField" binding-path="_font" label="Font" class="font-field" />
    </ui:VisualElement>

    <ui:VisualElement name="detailsContainer">
        <ui:VisualElement class="mie-block">
            <ui:TextField name="textField" binding-path="_text" label="Text" multiline="true" class="text-area" />
            <uie:PropertyField binding-path="_fontSize" label="Font Size" />
            <uie:PropertyField binding-path="_characterSize" label="Character Size" />
            <uie:PropertyField binding-path="_color" label="Color" />
        </ui:VisualElement>

        <ui:VisualElement class="mie-block">
            <ui:Label text="Layout" class="mie-header"/>
            <uie:PropertyField binding-path="_horizontal" label="Horizontal" />
            <uie:PropertyField binding-path="_vertical" label="Vertical" />
            <uie:PropertyField binding-path="_spacingX" label="Spacing X" />
            <uie:PropertyField binding-path="_spacingY" label="Spacing Y" />
            <mie:LimitedValueField binding-path="_maxWidth" label="Max Width" class="size-field"
                                      zero-label="Undefined"
                                      tooltip="0 is unlimited (Undefined)." />
            <mie:LimitedValueField binding-path="_maxHeight" label="Max Height" class="size-field"
                                      zero-label="Undefined"
                                      tooltip="0 is unlimited (Undefined)." />
            <uie:PropertyField binding-path="_breakDigits" label="Break Digits" />
        </ui:VisualElement>

        <ui:VisualElement name="outline" class="mie-block">
            <ui:Toggle name="isEnableToggle" text="Outline" class="mie-header-toggle" />
            <ui:VisualElement name="contentContainer" class="mie-content">
                <uie:PropertyField binding-path="_outlineSize" label="Size" />
                <uie:PropertyField binding-path="_outlineColor" label="Color" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="shadow" class="mie-block">
            <ui:Toggle name="isEnableToggle" text="Shadow" class="mie-header-toggle" />
            <ui:VisualElement name="contentContainer" class="mie-content">
                <uie:PropertyField binding-path="_shadowOffset" label="Offset" />
                <uie:PropertyField binding-path="_shadowColor" label="Color" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="effectsShiftBlock" class="mie-block">
            <uie:PropertyField binding-path="_effectsShiftZ" label="Effects Shift Z"
                               tooltip="Z offset for outline and shadow quads." />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
